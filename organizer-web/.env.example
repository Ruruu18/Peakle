NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set both site URLs to the actual HTTPS origins for a public deployment.
# Leave the player URL empty to hide the cross-app link until it is hosted.
NEXT_PUBLIC_PLAYER_APP_URL=

# Temporary pilot messaging is the default. Set true and rebuild/redeploy at
# release to restore the 14-day trial offer and email-signup trial requests.
NEXT_PUBLIC_ORGANIZER_TRIAL_ENABLED=false
# Optional feedback survey for organizers and players after testing. Empty
# opens an email questionnaire to support@peakle.app for the tester to send.
NEXT_PUBLIC_PILOT_FEEDBACK_URL=

# Optional: show the fake Peakle Summer Smash bracket outside local development.
# Local `npm run dev` already enables it automatically.
NEXT_PUBLIC_ENABLE_COMPETITION_DEMO=false
NEXT_PUBLIC_ENABLE_OPEN_PLAY_DEMO=false
