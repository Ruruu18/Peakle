{
  "expo": {
    "name": "Peakle",
    "slug": "peakle",
    "scheme": [
      "peakle",
      "com.peakle.app"
    ],
    "version": "1.0.0",
    "icon": "./public/images/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F5EF",
    "splash": {
      "backgroundColor": "#0E2321",
      "image": "./public/images/ball_green.png",
      "resizeMode": "contain"
    },
    "ios": {
      "buildNumber": "1",
      "supportsTablet": true,
      "bundleIdentifier": "com.peakle.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Peakle uses your location to find nearby courts, teams, and players.",
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "waze"
        ]
      }
    },
    "android": {
      "versionCode": 1,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.peakle.app",
      "adaptiveIcon": {
        "foregroundImage": "./public/images/adaptive-icon.png",
        "backgroundColor": "#0E2321"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Peakle Beta",
      "shortName": "Peakle",
      "favicon": "./public/images/web-favicon.png",
      "themeColor": "#0E2321",
      "backgroundColor": "#F3F5EF"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Peakle to use your location for nearby courts, teams, and players."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Peakle to access your photos so you can choose a profile picture."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Peakle to access your photos.",
          "savePhotosPermission": "Allow Peakle to save your completed match cards to Photos.",
          "granularPermissions": []
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./public/images/notification-icon.png",
          "color": "#D6E94A",
          "defaultChannel": "open-play"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E2321",
          "image": "./public/images/ball_green.png",
          "imageWidth": 68,
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to use the microphone so players can call out the score.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to recognize shouted scores during a match.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ],
      "@sentry/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "b1ea19b2-fa42-4318-9171-55c0dd48c7be"
      }
    }
  }
}
