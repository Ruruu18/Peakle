{
  "expo": {
    "name": "Peakle",
    "slug": "peakle",
    "scheme": [
      "peakle",
      "com.peakle.app"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F5EF",
    "splash": {
      "backgroundColor": "#0E2321",
      "image": "./public/images/ball_green.png",
      "resizeMode": "contain"
    },
    "ios": {
      "buildNumber": "1",
      "supportsTablet": true,
      "bundleIdentifier": "com.peakle.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Peakle uses your location to find nearby courts, teams, and players.",
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "waze"
        ]
      }
    },
    "android": {
      "versionCode": 1,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.peakle.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E2321"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Peakle to use your location for nearby courts, teams, and players."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Peakle to access your photos so you can choose a profile picture."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Peakle to access your photos.",
          "savePhotosPermission": "Allow Peakle to save your completed match cards to Photos.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./public/images/ball.png",
          "color": "#D6E94A",
          "defaultChannel": "open-play"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E2321",
          "image": "./public/images/ball_green.png",
          "imageWidth": 68,
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "b1ea19b2-fa42-4318-9171-55c0dd48c7be"
      }
    }
  }
}
