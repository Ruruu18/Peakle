# Supabase Dashboard > Project Settings > API. Never use the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://melbfzfuxrviybblipua.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Responsive organizer portal opened by the shortcuts in the player app.
EXPO_PUBLIC_ORGANIZER_PORTAL_URL=https://organizer.peakle.app
EXPO_PUBLIC_SUPPORT_EMAIL=support@peakle.app
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://melbfzfuxrviybblipua.supabase.co/functions/v1/legal/privacy
EXPO_PUBLIC_TERMS_URL=https://melbfzfuxrviybblipua.supabase.co/functions/v1/legal/terms
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://melbfzfuxrviybblipua.supabase.co/functions/v1/legal/account-deletion

# Google Cloud Console > APIs & Services > Credentials.
# Create one OAuth client for each platform you ship. Add all three client IDs
# to Supabase Auth's Google provider; use the Web client's secret there.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Sentry > Project Settings > Client Keys (DSN). Used for crash and error reporting.
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn
# Optional private EAS build credentials for readable release stack traces.
# Never prefix the auth token with EXPO_PUBLIC_.
SENTRY_ORG=your-sentry-organization
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-private-sentry-auth-token

# Set to 1 to build the investor/app-store demo: signs in as a fixed demo
# player, every screen reads canned data instead of Supabase, and the app
# drives itself through a short highlight reel automatically. Leave unset
# (or 0) for a normal build.
EXPO_PUBLIC_DEMO_MODE=0

# EAS production file secret (not an EXPO_PUBLIC value). Upload the Firebase
# google-services.json file as GOOGLE_SERVICES_JSON in the production environment.
# GOOGLE_SERVICES_JSON=/absolute/path/to/google-services.json
